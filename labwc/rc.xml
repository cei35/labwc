<labwc_config>

    <theme>
        <name>Adwaita-dark</name>
        <cornerRadius>8</cornerRadius>
        <font name="JetBrainsMono Nerd Font" size="10" />
    </theme>

    <keyboard>
        <default />
        <keybind key="Super_L" onRelease="yes">
            <action name="Execute" command="fuzzel"/>
        </keybind>
        <keybind key="Alt_L" onRelease="yes">
            <action name="Execute" command="~/.config/labwc/toggle-dock.sh"/>      <!-- Remind chmod +x toggle-dock -->
        </keybind>
        <keybind key="W-E">
            <action name="Execute" command="thunar"/>
        </keybind>
        <keybind key="C-A-t">
            <action name="Execute" command="foot"/>
        </keybind>
        <keybind key="C-S-m">
            <action name="Exit"/>
        </keybind>

        <keybind key="Print">
            <action name="Execute" command='sh -c "grim -g \"$(slurp)\" - | tee \"$HOME/Pictures/Screenshots/screenshot_$(date +%Y-%m-%d_%H-%M-%S).png\" | wl-copy"'/>
        </keybind>

        <keybind key="C-S-Escape">
            <action name="Execute" command="foot -e htop"/>
        </keybind>

        <keybind key="W-l">
            <action name="Execute" command="swaylock"/>
        </keybind>

                <!--    BRIGHTNESS  -->
        <keybind key="XF86MonBrightnessUp">
            <action name="Execute" command="brightnessctl set +5%" />
        </keybind>
        <keybind key="XF86MonBrightnessDown">
            <action name="Execute" command="brightnessctl set 5%-" />
        </keybind>

                <!--    AUDIO   -->
        <keybind key="XF86AudioRaiseVolume">
            <action name="Execute" command="pamixer -i 5" />
        </keybind>
        <keybind key="XF86AudioLowerVolume">
            <action name="Execute" command="pamixer -d 5" />
        </keybind>
        <keybind key="XF86AudioMute">
            <action name="Execute" command="pamixer -t" />
        </keybind>

                <!--    DOCK KEYBINDINGS    -->
        <keybind key="W-S-1" onRelease="yes">
            <action name="Execute" command="keepassxc"/>
        </keybind>
        <keybind key="W-S-2" onRelease="yes">
            <action name="Execute" command="librewolf"/>
        </keybind>
        <keybind key="W-S-3" onRelease="yes">
            <action name="Execute" command="thunar"/>
        </keybind>
        <keybind key="W-S-4" onRelease="yes">
            <action name="Execute" command="kate"/>
        </keybind>
        <keybind key="W-S-5" onRelease="yes">
            <action name="Execute" command="mousepad"/>
        </keybind>
        <keybind key="W-S-6" onRelease="yes">
            <action name="Execute" command="libreoffice --writer"/>
        </keybind>
        <keybind key="W-S-7" onRelease="yes">
            <action name="Execute" command="foot"/>
        </keybind>
        <keybind key="W-S-8" onRelease="yes">
            <action name="Execute" command="virt-manager"/>
        </keybind>
    </keyboard>

    <mouse>    
        <default />
        <context name="Root">
            <mousebind button="Left" action="Press">
                <action name="None" />
            </mousebind>
            <mousebind button="Right" action="Press">
                <action name="ShowMenu" menu="root-menu" />
            </mousebind>
        </context>
    </mouse>

    <desktops>
        <initial>1</initial>
        <names>
            <name>1</name>
            <name>2</name>
            <name>3</name>
        </names>
    </desktops>

</labwc_config>